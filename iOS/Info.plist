<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- audio: keep playing when the app is backgrounded or the screen
	     locks. remote-notification: let CloudKit's silent pushes reach
	     CKSyncEngine while the app is in the background, so the listening
	     state from another device is already in place when you pick this
	     one up rather than arriving after you're looking at it. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
		<string>remote-notification</string>
	</array>
	<!-- Declares the CarPlay scene. The phone UI keeps using the SwiftUI
	     App lifecycle; this manifest only adds the car screen, pointing
	     iOS at CarPlaySceneDelegate when a car connects. -->
	<!-- The network's typefaces, bundled from Fonts/. Archivo Black stands
	     in for the site's licensed display face; Open Sans is the site's
	     own body face. -->
	<!-- The launch screen: the network's lockup centred on their navy.
	     Defined here rather than generated, which is why
	     INFOPLIST_KEY_UILaunchScreen_Generation is NO in the project. -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
		<key>UIImageName</key>
		<string>LaunchLogo</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- Only HTTPS, which is exempt — answers App Store Connect's export
	     compliance question once instead of on every upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<!-- The catalogue API. Overridable at runtime with a launch argument
	     (-APIBaseURL http://localhost:7331) so a build can be pointed at a
	     local checkout of api/ or a staging deploy without rebuilding. -->
	<key>APIBaseURL</key>
	<string>https://gcp-player-api.vercel.app</string>
	<!-- Loopback and local-network HTTP only, so the simulator can reach a
	     local API. Everything else still requires HTTPS, which is what keeps
	     ITSAppUsesNonExemptEncryption above honest. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>UIAppFonts</key>
	<array>
		<string>ArchivoBlack-Regular.ttf</string>
		<string>OpenSans-Regular.ttf</string>
		<string>OpenSans-SemiBold.ttf</string>
		<string>OpenSans-Bold.ttf</string>
	</array>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<true/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>CPTemplateApplicationSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>CPTemplateApplicationScene</string>
					<key>UISceneConfigurationName</key>
					<string>CarPlay</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).CarPlaySceneDelegate</string>
				</dict>
			</array>
		</dict>
	</dict>
</dict>
</plist>
