    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.0",
    "@types/react-dom": "19.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "jsdom": "27.0.0",
    "storybook": "9.1.10",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "7.1.8",
    "vitest": "5.0.1"
