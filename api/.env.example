# ─── Database ────────────────────────────────────────────────────────────────
# On Vercel both are set for you when you attach a Neon integration.
#
# DATABASE_URL is the POOLED endpoint (the host contains "-pooler"). Serverless
# functions open a connection per invocation, so going direct exhausts Postgres'
# connection limit under any real traffic.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"
# DATABASE_URL_UNPOOLED is the DIRECT endpoint, used only by `prisma migrate`.
# Migrations need session-level locks that pgbouncer's transaction mode can't
# carry, and pointing migrate at the pooler fails in ways that look like
# network flakes.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require"

# Locally these are usually the same string — see .env for what the repo uses.

# ─── Auth ────────────────────────────────────────────────────────────────────
# Writes are behind a staff session now, not a shared token: sign in at the
# dashboard with an emailed code. Create the first staff row with
# `npm run db:staff -- you@example.com "Your Name"`.
#
# SESSION_KEY keys the HMAC over those codes. At least 32 characters.
# Rotating it invalidates codes that have been emailed but not yet typed in —
# a ten-minute window — and leaves existing sessions alone.
SESSION_KEY="generate-with-openssl-rand-base64-32"

# Vercel sets this itself for scheduled invocations; set it locally to call
# /cron/sync by hand.
CRON_SECRET="generate-with-openssl-rand-base64-32"

# ─── Caching ─────────────────────────────────────────────────────────────────
# Whether public reads may be held at the edge for an hour. On when unset, so
# the deployed default is the cheap one. Set it to false while editing the
# catalogue, when every change has to be visible immediately — and as the first
# thing to try when a client looks out of date, since it separates a stale edge
# from a wrong row. Accepts true/false, 1/0 and yes/no.
#
# ENABLE_VERCEL_CACHE="false"

# ─── Email ───────────────────────────────────────────────────────────────────
# Sends the sign-in code, through the Resend template aliased `otp` — it takes
# one variable, OTP_CODE. Currently the Going Somewhere Resend account, which
# already has that template and a verified domain.
#
# Leave them unset locally and the code is written to the API log instead of
# emailed, so signing in needs no inbox. Both are required in production:
# without them nobody can get into a deployed dashboard at all.
RESEND_API_KEY=
RESEND_FROM=Going Somewhere <hello@goingsomewhere.app>
